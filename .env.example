# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Port for `python app.py` (gunicorn uses --bind instead).
PORT=5001

# Set to 1 ONLY when a reverse proxy (nginx, Caddy, Cloudflare) sits in front.
# Without one, X-Forwarded-For is attacker-controlled.
TRUST_PROXY=0

# Optional: use a different database file / engine.
# DATABASE_URL=sqlite:////opt/atten/instance/atten.db

# Optional fallbacks — normally configured in Admin -> Settings instead.
# DISCORD_WEBHOOK_URL=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=Atten
